{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jo-on-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // No nodejs_compat: @anthropic-ai/sdk runs on the Workers fetch runtime as-is.

  // Shared chat logic lives in ../portfolio_v2/src/lib/chat and imports
  // "@/data/site" (a Next.js path alias). Point the bundler at the same file
  // so portfolio_v2/src/data/site.ts stays the single source of truth.
  "alias": {
    "@/data/site": "../portfolio_v2/src/data/site.ts"
  },

  // Plain (non-secret) settings. ANTHROPIC_API_KEY is a secret:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // Locally, .dev.vars overrides these (see .dev.vars.example).
  "vars": {
    "ALLOWED_ORIGINS": "https://jo-onn.github.io,http://localhost:3000,http://127.0.0.1:3000",
    "CHAT_MOCK": "0",
    // Per client IP (IPv6 grouped by /64). Enforced exactly by the IP_LIMITER
    // Durable Object. The Workers Rate Limiting binding was dropped: its counts
    // are approximate and it never blocked anything on workers.dev.
    "RATE_LIMIT_PER_MINUTE": "10",
    "RATE_LIMIT_PER_DAY": "50"
  },

  // One SQLite-backed Durable Object per client IP (src/ipLimiter.ts).
  "durable_objects": {
    "bindings": [{ "name": "IP_LIMITER", "class_name": "IpRateLimiter" }]
  },
  "exports": {
    "IpRateLimiter": { "type": "durable-object", "storage": "sqlite" }
  },

  "observability": { "enabled": true }
}
