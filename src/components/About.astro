---
import { siteConfig } from "../config";
---

<section
  id="about"
  class="dot-bg py-14 px-10 md:px-20 lg:px-32"
>
  <!-- Small label -->
  <span
    class="inline-block text-xs font-mono font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-8"
  >
    About
  </span>

  <!-- Bio text -->
  {siteConfig.aboutMe && (
    <div
      class="about-bio max-w-5xl mb-6"
      set:html={siteConfig.aboutMe}
    />
  )}

  <!-- Skills line -->
  {siteConfig.skills && siteConfig.skills.length > 0 && (
    <p class="text-sm text-gray-600 max-w-5xl">
      <span class="font-bold text-gray-800">🔬 Research Interests:</span>{" "}
      {siteConfig.skills.join(", ")}.
    </p>
  )}
</section>
