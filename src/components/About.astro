---
import { siteConfig } from "../config";
import Graph from "./Graph.astro";
---

<section id="about" class="py-3 px-3 sm:py-4 sm:px-5 md:py-6 md:px-6 h-full flex flex-col">
  <div class="max-w-7xl mx-auto w-full flex-1 flex flex-col min-h-0">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 flex-1 min-h-0">

      <!-- Left: title + text + skills -->
      <div class="lg:col-span-4 flex flex-col overflow-y-auto">
        <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900">
          About Me
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        ></div>
        {siteConfig.sectionSubtitles?.about && (
          <p class="mt-3 text-lg text-gray-400">{siteConfig.sectionSubtitles.about}</p>
        )}

        <p class="mt-6 text-lg sm:text-xl leading-relaxed text-gray-600 [&_strong]:font-extrabold [&_strong]:text-gray-900" set:html={siteConfig.aboutMe} />

        <div class="mt-6 pt-4 border-t border-gray-100">
          <div class="flex flex-wrap gap-2">
            {siteConfig.skills.map((skill) => (
              <span class="px-3 py-1.5 bg-gray-100 text-gray-800 rounded-full text-sm font-medium hover:bg-gray-200 transition-colors duration-200">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Graph -->
      <div class="lg:col-span-8 flex items-start justify-center">
        <div
          class="w-full h-[500px]"
          style="overflow: visible; mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, black 30%, transparent 95%); -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, black 30%, transparent 95%);"
        >
          <Graph />
        </div>
      </div>

    </div>
  </div>
</section>