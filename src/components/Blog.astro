---
import { getCollection } from "astro:content";
import { siteConfig } from "../config";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

{
  posts.length > 0 && (
    <section id="blog" class="p-4 sm:p-6 md:p-8">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Blog
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            {siteConfig.sectionSubtitles?.blog && (
              <p class="mt-3 text-lg text-gray-400">{siteConfig.sectionSubtitles.blog}</p>
            )}
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {posts.map((post, index) => (
                <div class="group relative">
                  <a
                    href={`${import.meta.env.BASE_URL}/blog/${post.slug}`}
                    class="block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-500 overflow-hidden hover:bg-white hover:shadow-2xl hover:border-gray-300 hover:-translate-y-2 hover:scale-[1.01]"
                  >
                    <div
                      class="absolute left-0 top-0 h-full w-1 rounded-l-xl scale-y-0 group-hover:scale-y-100 transition-transform duration-500 origin-top"
                      style={`background-color: ${siteConfig.accentColor}`}
                    />
                    <div class="space-y-3">
                      <div>
                        <span
                          class="text-sm font-mono"
                          style={{ color: siteConfig.accentColor }}
                        >
                          0{index + 1}
                        </span>
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1 transition-colors duration-300 group-hover:text-gray-700">
                          {post.data.title}
                        </h3>
                      </div>
                      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
                        {post.data.description}
                      </p>
                      <div class="flex items-center justify-between pt-1">
                        <div class="flex flex-wrap gap-1.5">
                          {post.data.tags.map((tag: string) => (
                            <span class="px-2.5 py-1 bg-gray-900 text-white rounded-md text-xs font-medium">
                              #{tag}
                            </span>
                          ))}
                        </div>
                        <time class="text-sm text-gray-400 font-mono shrink-0 ml-4">
                          {post.data.date.toLocaleDateString("ko-KR", { year: "numeric", month: "short", day: "numeric" })}
                        </time>
                      </div>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
