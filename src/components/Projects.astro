---
import { siteConfig } from "../config";
import clinicalNlpImg from "../assets/clinical-nlp.png";
import medicalImagingImg from "../assets/medical-imaging.png";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const projectImages = [clinicalNlpImg, medicalImagingImg];
---

{hasProjects && (
  <section
    id="projects"
    class="dot-bg py-14 px-10 md:px-20 lg:px-32"
  >

    <!-- Title -->
    <div class="mb-12">
      {siteConfig.sectionSubtitles?.projects && (
        <span class="eyebrow inline-block w-fit text-xs font-mono font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-6">
          {siteConfig.sectionSubtitles.projects}
        </span>
      )}
      <h2 class="font-extrabold leading-tight" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">
        Featured <span style="background: linear-gradient(135deg, #7c3aed, #db2877); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Projects</span>
      </h2>
      {siteConfig.sectionDescriptions?.projects && (
        <p class="mt-4 text-sm text-gray-400 whitespace-nowrap" style="height: 1.5em;">
          <span class="section-typewriter" data-phrases={JSON.stringify([siteConfig.sectionDescriptions.projects, siteConfig.sectionDescriptionsEn?.projects ?? ""])}>{siteConfig.sectionDescriptions.projects}</span>
        </p>
      )}
    </div>

    <!-- Project list -->
    <div class="flex flex-col gap-6">
      {siteConfig.projects.map((project, i) => (
        <div
          class="group bg-white rounded-2xl border border-gray-100 overflow-hidden transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
          style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);"
        >
          <div class="flex flex-col sm:flex-row">

            <!-- Thumbnail strip -->
            <div
              class="sm:w-48 shrink-0 flex items-center justify-center overflow-hidden"
              style="background: linear-gradient(135deg, #ede9fe, #fce7f3); min-height: 140px;"
            >
              {projectImages[i] ? (
                <img
                  src={projectImages[i].src}
                  alt=""
                  class="w-full h-full object-cover"
                  style="opacity: 0.85;"
                />
              ) : (
                <div style="font-size: 3rem; opacity: 0.3;">🔬</div>
              )}
            </div>

            <!-- Content -->
            <div class="flex-1 p-6 md:p-8 flex flex-col gap-3">

              <!-- Number + skills row -->
              <div class="flex items-center justify-between gap-4">
                <span class="text-xs font-mono text-gray-400">0{i + 1}</span>
                <div class="flex flex-wrap gap-1.5 justify-end">
                  {project.skills?.map((skill) => (
                    <span
                      class="px-2.5 py-0.5 rounded-full text-xs font-medium border"
                      style="background: #f5f3ff; color: #7c3aed; border-color: #ede9fe;"
                    >
                      {skill}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Title + link -->
              <div class="flex items-start justify-between gap-4">
                <h3
                  class="text-lg font-bold text-gray-900 leading-snug"
                 
                >
                  {project.name}
                </h3>
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Link"
                    class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full border border-gray-200 text-gray-400 transition-all hover:border-purple-300 hover:text-purple-500"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17L17 7M17 7H7M17 7V17"/>
                    </svg>
                  </a>
                )}
              </div>

              <!-- Description -->
              <p class="text-sm text-gray-500 leading-relaxed">
                {project.description}
              </p>

            </div>
          </div>
        </div>
      ))}
    </div>

  </section>
)}
