---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const linkIcons: Record<string, string> = {
  GitHub:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.268 2.75 1.026A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.026 2.747-1.026.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>`,
  Paper:   `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`,
  Demo:    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`,
  Blog:    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
};
---

{hasProjects && (
  <section id="projects" class="dot-bg py-10 px-8 md:px-16 lg:px-24 min-h-screen">

    <!-- Heading -->
    <div class="text-center mb-8">
      {siteConfig.sectionSubtitles?.projects && (
        <span class="inline-block text-xs font-sans font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-4">
          {siteConfig.sectionSubtitles.projects}
        </span>
      )}
      <h2 class="text-gray-900 leading-tight" style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 550;">
        My Latest Work
      </h2>
    </div>

    <!-- Card grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {siteConfig.projects.map((project) => (
        <div class="project-card group flex flex-col rounded-2xl border border-gray-100 bg-white overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="box-shadow: 0 2px 16px rgba(0,0,0,0.06);">

          <!-- Thumbnail: crossfade on hover -->
          <div class="img-stage relative overflow-hidden bg-gray-100" style="height: 200px;">
            {project.images && project.images.length > 0 ? (
              project.images.map((src, idx) => (
                <img
                  src={`${base}${src}`}
                  alt={project.name}
                  class="crossfade-img absolute inset-0 w-full h-full object-cover transition-opacity duration-700"
                  style={`object-position: ${project.imagePosition ?? "center center"}; opacity: ${idx === 0 ? 1 : 0}; z-index: ${project.images!.length - idx};`}
                />
              ))
            ) : (
              <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, #ede9fe, #fce7f3);">
                <span style="font-size: 3rem; opacity: 0.3;">🔬</span>
              </div>
            )}

            <!-- Link overlay on hover (only if links exist) -->
            {project.links && project.links.length > 0 && (
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all duration-300 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100" style="z-index: 99;">
                {project.links.map((lk) => (
                  <a
                    href={lk.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white text-gray-900 text-xs font-sans font-semibold hover:bg-gray-100 transition-colors"
                    set:html={`${linkIcons[lk.label] ?? ""} ${lk.label}`}
                  />
                ))}
              </div>
            )}
          </div>

          <!-- Content -->
          <div class="flex flex-col flex-1 p-6 gap-2">

            <!-- Date + badges -->
            <div class="flex items-center gap-2 flex-wrap">
              {project.dateRange && (
                <p class="text-xs font-sans text-gray-400">{project.dateRange}</p>
              )}
              {project.badges?.map((b) => (
                <span class="text-xs font-sans font-semibold px-2 py-0.5 rounded-full" style={
                  b.type === "paper"      ? "background:#ede9fe; color:#6d28d9;" :
                  b.type === "conference" ? "background:#fce7f3; color:#be185d;" :
                  b.type === "award"      ? "background:#fef3c7; color:#b45309;" :
                  b.type === "status"     ? "background:#d1fae5; color:#065f46;" :
                                           "background:#dbeafe; color:#1d4ed8;"
                }>
                  {b.label}
                </span>
              ))}
            </div>

            <!-- Title -->
            <h3 class="font-bold text-gray-900 text-base leading-snug">
              {project.name}
            </h3>

            <!-- Description -->
            <p class="text-sm text-gray-500 leading-relaxed flex-1">
              {project.description}
            </p>

            <!-- Skill tags -->
            {project.skills && project.skills.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-2">
                {project.skills.map((skill) => (
                  <span class="text-xs font-sans font-medium px-2.5 py-0.5 rounded-full border border-gray-200 text-gray-500 bg-gray-50">
                    {skill}
                  </span>
                ))}
              </div>
            )}

            <!-- Inline links -->
            {project.links && project.links.length > 0 && (
              <div class="flex gap-3 pt-3 border-t border-gray-100">
                {project.links.map((lk) => (
                  <a
                    href={lk.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-gray-500 hover:text-gray-900 transition-colors"
                    set:html={`${linkIcons[lk.label] ?? ""} ${lk.label}`}
                  />
                ))}
              </div>
            )}

          </div>
        </div>
      ))}
    </div>

  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
    const stage = card.querySelector<HTMLElement>(".img-stage");
    if (!stage) return;

    const imgs = Array.from(stage.querySelectorAll<HTMLImageElement>(".crossfade-img"));
    if (imgs.length < 2) return;

    let current = 0;
    let timer: ReturnType<typeof setTimeout>;

    const showNext = () => {
      imgs[current].style.opacity = "0";
      current = (current + 1) % imgs.length;
      imgs[current].style.opacity = "1";
    };

    card.addEventListener("mouseenter", () => {
      timer = setTimeout(showNext, 600); // 0.6s 후 첫 전환
    });

    card.addEventListener("mouseleave", () => {
      clearTimeout(timer);
      // 원래 첫 번째 이미지로 복귀
      imgs.forEach((img, i) => {
        img.style.opacity = i === 0 ? "1" : "0";
      });
      current = 0;
    });
  });
</script>
