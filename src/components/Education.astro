---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---
{hasEducation && (
  <section
    id="education"
    class="dot-bg py-14 px-10 md:px-20 lg:px-32"
  >

    <!-- Title -->
    <div class="mb-12">
      {siteConfig.sectionSubtitles?.education && (
        <span class="eyebrow inline-block w-fit text-xs font-mono font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-6">
          {siteConfig.sectionSubtitles.education}
        </span>
      )}
      <h2 class="font-extrabold leading-tight" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">
        <span style="background: linear-gradient(135deg, #7c3aed, #db2877); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Education</span>
      </h2>
      {siteConfig.sectionDescriptions?.education && (
        <p class="mt-4 text-sm text-gray-400 whitespace-nowrap" style="height: 1.5em;">
          <span class="section-typewriter" data-phrases={JSON.stringify([siteConfig.sectionDescriptions.education, siteConfig.sectionDescriptionsEn?.education ?? ""])}>{siteConfig.sectionDescriptions.education}</span>
        </p>
      )}
    </div>

    <!-- Education cards -->
    <div class="flex flex-col gap-5">
      {siteConfig.education.map((edu, i) => (
        <div
          class="group bg-white rounded-2xl border border-gray-100 p-6 md:p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
          style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);"
        >
          <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-6">

            <!-- Icon badge -->
            <div
              class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center text-xl"
              style="background: linear-gradient(135deg, #ede9fe, #fce7f3);"
            >
              {i === 0 ? "🎓" : "📚"}
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                <div>
                  <h3 class="text-base font-bold text-gray-900 leading-tight">
                    {edu.degree}
                  </h3>
                  <p class="text-sm font-semibold mt-0.5" style="color: #7c3aed">
                    {edu.school}
                  </p>
                </div>
                <span
                  class="text-xs font-mono text-gray-400 px-3 py-1 rounded-full border border-gray-100 bg-gray-50 shrink-0"
                >
                  {edu.dateRange}
                </span>
              </div>

              <ul class="mt-3 flex flex-col gap-1.5">
                {edu.achievements.map((a) => (
                  <li class="flex items-start gap-2 text-sm text-gray-500">
                    <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-purple-300 shrink-0"></span>
                    {a}
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </div>
      ))}
    </div>

  </section>
)}
