---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<header
  id="header"
  class="fixed top-0 right-0 z-50 hidden md:flex h-[30vh] items-center transition-opacity duration-500"
>
  <nav class="px-13 pt-100">
    <ul class="flex flex-col items-end gap-10">
      <li>
        <a href="#about" class="text-gray-700 hover:text-black transition-colors font-medium text-3xl">
          About
        </a>
      </li>
      {hasExperience && (
        <li>
          <a href="#experience" class="text-gray-700 hover:text-black transition-colors font-medium text-3xl">
            Experience
          </a>
        </li>
      )}
      {hasProjects && (
        <li>
          <a href="#projects" class="text-gray-700 hover:text-black transition-colors font-medium text-3xl">
            Projects
          </a>
        </li>
      )}
      <li>
        <a href="#blog" class="text-gray-700 hover:text-black transition-colors font-medium text-3xl">
          Blog
        </a>
      </li>
      {hasEducation && (
        <li>
          <a href="#education" class="text-gray-700 hover:text-black transition-colors font-medium text-3xl">
            Education
          </a>
        </li>
      )}
    </ul>
  </nav>
</header>

<script>
  const container = document.querySelector(".snap-container");
  const header = document.getElementById("header");
  const heroEl = document.getElementById("hero");

  if (container && header) {
    const updateHeader = () => {
      const heroHeight = heroEl?.offsetHeight ?? window.innerHeight;
      const scrolled = container.scrollTop;

      if (scrolled < heroHeight * 0.5) {
        // Hero 구간 — 완전히 숨김
        header.style.opacity = "0";
        header.style.pointerEvents = "none";
      } else {
        // Hero 벗어난 후 — 서서히 나타나다가 스크롤 내릴수록 흐려짐
        const fadeIn = Math.min(1, (scrolled - heroHeight * 0.5) / (heroHeight * 0.3));
        const fadeOut = Math.max(0.2, 1 - (scrolled - heroHeight) / 1000);
        header.style.opacity = String(Math.min(fadeIn, fadeOut));
        header.style.pointerEvents = "auto";
      }
    };

    container.addEventListener("scroll", updateHeader);
    updateHeader();
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
