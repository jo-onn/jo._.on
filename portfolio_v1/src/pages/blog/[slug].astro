---
import { getCollection } from "astro:content";
import { siteConfig } from "../../config";
import "../../styles/blog.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} — {siteConfig.name}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous" />
    <style>
      body { font-family: sans-serif; }
    </style>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-16">
      <a
        href={`${import.meta.env.BASE_URL}/#blog`}
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 transition-colors font-mono mb-10"
      >
        ← Back
      </a>

      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map((tag: string) => (
            <span
              class="px-2.5 py-1 rounded-md text-xs font-medium text-white"
              style={`background-color: ${siteConfig.accentColor}`}
            >
              #{tag}
            </span>
          ))}
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-4">
          {post.data.title}
        </h1>
        <p class="text-lg text-gray-500">{post.data.description}</p>
        <time class="block mt-4 text-sm text-gray-400 font-mono">
          {post.data.date.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <div class="w-full h-px bg-gray-100 mt-8" />
      </header>

      <article class="prose prose-gray prose-lg max-w-none">
        <Content />
      </article>
    </div>
  </body>
</html>
