---
import { siteConfig } from "../config";
import sampleImg from "../assets/image.png";
---

<div
  id="hero"
  class="relative flex items-center justify-center px-6 pt-60 pb-10"
  style="background: transparent;"
>
  <div class="w-full max-w-[45rem] flex flex-col items-center gap-6">

    <!-- Floating card -->
    <div
      class="w-full bg-white rounded-3xl border border-gray-100 px-8 py-12 animate-fade-in"
      style="box-shadow: 0 8px 48px rgba(0,0,0,0.10); background-image: linear-gradient(rgba(200,208,224,0.25) 1px, transparent 1px), linear-gradient(90deg, rgba(200,208,224,0.25) 1px, transparent 1px); background-size: 32px 32px; background-color: white;"
    >
      <div class="flex flex-col-reverse sm:flex-row items-center gap-7 sm:gap-12">

        <!-- Left: info -->
        <div class="flex-1 flex flex-col gap-2 min-w-0 items-center sm:items-start text-center sm:text-left" style="font-size: 1.25em;">
          <p id="hero-greeting" class="text-s font-mono text-gray-400">HELLO 👋</p>

          <h1
            class="font-extrabold leading-tight"
            style="font-size: clamp(2.2rem, 7vw, 4rem); white-space: nowrap;"
          >
            <span id="hero-prefix" style="color: #c8cdd6; font-weight: 600; font-size: 0.4em; margin-right: 0.4em;">I'm</span>{siteConfig.name}<span id="hero-suffix" style="color: #c8cdd6; font-weight: 800; font-size: 0.52em; margin-left: 0.4em;"></span>
          </h1>

          <p class="text-l sm:text-base text-gray-500 font-mono mt-3">
            <span id="typing-text"></span><span id="typing-cursor" style="color: #7c3aed;">|</span>
          </p>

        </div>

        <!-- Right: photo with double ring -->
        <div class="shrink-0">
          <!-- Outer gradient ring -->
          <div style="border-radius: 50%; padding: 2.5px; background: linear-gradient(135deg, rgba(255,195,150,0.75) 0%, rgba(185,220,230,0.65) 50%, rgba(255,210,170,0.6) 100%);">
            <!-- Gap filled with background color -->
            <div style="border-radius: 50%; padding: 7px; background: #faf7f4;">
              <img
                src={sampleImg.src}
                alt=""
                style="display: block; width: clamp(130px, 18vw, 165px); height: clamp(130px, 18vw, 165px); border-radius: 50%; object-fit: cover;"
              />
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Divider -->
    <div class="animate-fade-in w-full flex justify-center">
      <div style="width: 55%; height: 1px; background: linear-gradient(90deg, transparent, #d1d5db, transparent);"></div>
    </div>

    <!-- Contact links -->
    <div class="flex items-center gap-2 animate-fade-in">
      {siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="w-12 h-12 flex items-center justify-center rounded-xl text-gray-400 transition-all duration-200 hover:text-gray-600"
          style="background: transparent;"
          onmouseenter="this.style.background='rgba(255,255,255,0.7)'"
          onmouseleave="this.style.background='transparent'"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg>
        </a>
      )}
      {siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="w-12 h-12 flex items-center justify-center rounded-xl text-gray-400 transition-all duration-200 hover:text-gray-600"
          style="background: transparent;"
          onmouseenter="this.style.background='rgba(255,255,255,0.7)'"
          onmouseleave="this.style.background='transparent'"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 1 0 -4 0"/><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"/></svg>
        </a>
      )}
      {siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="w-12 h-12 flex items-center justify-center rounded-xl text-gray-400 transition-all duration-200 hover:text-gray-600"
          style="background: transparent;"
          onmouseenter="this.style.background='rgba(255,255,255,0.7)'"
          onmouseleave="this.style.background='transparent'"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/></svg>
        </a>
      )}
    </div>

  </div>

</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.7s ease-out forwards;
    opacity: 0;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  #typing-cursor { animation: blink 0.8s infinite; }
</style>

<script define:vars={{ titleEn: siteConfig.title, titleKo: siteConfig.titleKo }}>
  const el = document.getElementById("typing-text");

  const COPY = {
    en: { greeting: "HELLO 👋",    prefix: "I'm", suffix: "",       title: titleEn },
    ko: { greeting: "안녕하세요 👋", prefix: "저는", suffix: "입니다", title: titleKo || titleEn },
  };

  const greetingEl = document.getElementById("hero-greeting");
  const prefixEl   = document.getElementById("hero-prefix");
  const suffixEl   = document.getElementById("hero-suffix");

  let typingTimer = null;

  function typeTitle(text) {
    if (typingTimer) clearInterval(typingTimer);
    if (!el) return;
    el.textContent = "";
    let i = 0;
    typingTimer = setInterval(() => {
      el.textContent = text.slice(0, ++i);
      if (i >= text.length) clearInterval(typingTimer);
    }, 60);
  }

  /* Static copy swaps immediately; the title re-types so the effect is kept. */
  function applyHeroLang(lang, retype) {
    const c = COPY[lang] ?? COPY.en;
    if (greetingEl) greetingEl.textContent = c.greeting;
    if (prefixEl)   prefixEl.textContent   = c.prefix;
    if (suffixEl)   suffixEl.textContent   = c.suffix;
    if (retype) typeTitle(c.title);
  }

  /* The inline <head> script has already set data-lang, so this is correct on first paint. */
  let heroLang = document.documentElement.dataset.lang === "ko" ? "ko" : "en";
  applyHeroLang(heroLang, false);
  setTimeout(() => applyHeroLang(heroLang, true), 600);

  window.addEventListener("langchange", (e) => {
    const next = e.detail === "ko" ? "ko" : "en";
    if (next === heroLang) return;
    heroLang = next;
    applyHeroLang(heroLang, true);
  });
</script>
