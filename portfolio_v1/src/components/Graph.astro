---
import { siteConfig } from "../config";
import medicalImagingImg from "../assets/medical-imaging.png";
import clinicalNlpImg    from "../assets/clinical-nlp.png";

// Simple Icons CDN: https://cdn.simpleicons.org/{slug}/{hex-color}
const iconUrlMap: Record<string, string> = {
  "Python":          "https://cdn.simpleicons.org/python/3776AB",
  "PyTorch":         "https://cdn.simpleicons.org/pytorch/EE4C2C",
  "FastAPI":         "https://cdn.simpleicons.org/fastapi/009688",
  "Docker":          "https://cdn.simpleicons.org/docker/2496ED",
  "Git":             "https://cdn.simpleicons.org/git/F05032",
  "Computer Vision": "https://cdn.simpleicons.org/opencv/5C3EE8",
  "Medical Imaging": medicalImagingImg.src,
  "Clinical NLP":    clinicalNlpImg.src,
  "GitHub":          "https://cdn.simpleicons.org/github/181717",
  "Figma":           "https://cdn.simpleicons.org/figma/F24E1E",
  "CSS":             "https://cdn.simpleicons.org/css3/1572B6",
  "Tailwind":        "https://cdn.simpleicons.org/tailwindcss/06B6D4",
};

const emojiFallback: Record<string, string> = {};

const extraSkills = ["GitHub", "Figma", "CSS", "Tailwind"];

const items = [
  ...siteConfig.skills,
  ...extraSkills,
].map((s) => ({
  label: s,
  type: "skill" as const,
  href: "#about",
}));
---

<section id="skills" class="dot-bg py-14 px-10 md:px-20 lg:px-32">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

    <!-- Left: title -->
    <div class="flex flex-col justify-center">
      {siteConfig.sectionSubtitles?.about && (
        <span class="eyebrow inline-block w-fit text-xs font-sans font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-6">
          Tech Stack
        </span>
      )}
      <h2 class="leading-tight" style="font-size: clamp(2.2rem, 4.5vw, 4rem); font-weight: 550;">
        My Skills
      </h2>
    </div>

    <!-- Right: Globe -->
    <div class="flex items-center justify-center">
      <div
        id="globe-wrap"
        class="w-full h-[520px]"
        style="mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, black 60%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, black 60%, transparent 100%);"
      >
        <canvas id="globe-canvas" class="w-full h-full cursor-grab"></canvas>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ items, iconUrlMap, emojiFallback, accentColor: siteConfig.accentColor }}>
  const canvas = document.getElementById("globe-canvas");
  const wrap   = document.getElementById("globe-wrap");
  const ctx    = canvas.getContext("2d");

  function resize() {
    canvas.width  = wrap.clientWidth;
    canvas.height = wrap.clientHeight;
  }
  resize();
  new ResizeObserver(resize).observe(wrap);

  // ── Preload images ───────────────────────────────────────────────────
  const imgCache = {};
  Object.entries(iconUrlMap).forEach(([label, url]) => {
    const img = new Image();
    if (url.startsWith("http")) img.crossOrigin = "anonymous";
    img.src = url;
    imgCache[label] = img;
  });

  // ── Fibonacci sphere placement ───────────────────────────────────────
  const goldenAngle = Math.PI * (3 - Math.sqrt(5));
  const pts = items.map((item, i) => {
    const y = 1 - (i / Math.max(items.length - 1, 1)) * 2;
    const r = Math.sqrt(Math.max(0, 1 - y * y));
    const t = goldenAngle * i;
    return { ...item, ox: Math.cos(t) * r, oy: y, oz: Math.sin(t) * r };
  });

  // ── Rotation state ───────────────────────────────────────────────────
  let rotX = 0.25, rotY = 0;
  let velX = 0,    velY = 0.0025;
  let dragging = false, lastMX = 0, lastMY = 0;
  let hoveredIdx = -1;

  // ── 3-D helpers ──────────────────────────────────────────────────────
  function rotate(ox, oy, oz, rx, ry) {
    const cy = Math.cos(ry), sy = Math.sin(ry);
    const x1 =  ox * cy + oz * sy;
    const z1 = -ox * sy + oz * cy;
    const cx = Math.cos(rx), sx = Math.sin(rx);
    return { x: x1, y: oy * cx - z1 * sx, z: oy * sx + z1 * cx };
  }

  function project(x, y, z) {
    const cx = canvas.width  / 2;
    const cy = canvas.height / 2;
    const R  = Math.min(cx, cy) * 0.74;
    const fov = 2.4;
    const s = fov / (fov + z);
    return { sx: cx + x * R * s, sy: cy + y * R * s, scale: s, depth: z, R };
  }

  function isDark() {
    return document.documentElement.classList.contains("dark");
  }

  // ── Wireframe ────────────────────────────────────────────────────────
  function drawWireframe() {
    const cx = canvas.width  / 2;
    const cy = canvas.height / 2;
    const R  = Math.min(cx, cy) * 0.74;
    const dark = isDark();

    ctx.save();
    ctx.strokeStyle = dark ? "rgba(56,189,248,0.22)" : "rgba(170,185,210,0.2)";
    ctx.lineWidth = 0.7;

    [-60,-30,0,30,60].forEach((lat) => {
      const phi = lat * Math.PI / 180;
      const rr  = R * Math.cos(phi);
      const yOff = R * Math.sin(phi) * Math.cos(rotX);
      ctx.beginPath();
      ctx.ellipse(cx, cy + yOff, rr * Math.max(0.08, Math.abs(Math.cos(rotY))), rr * Math.abs(Math.sin(rotX + Math.PI / 2)), 0, 0, Math.PI * 2);
      ctx.stroke();
    });

    for (let lon = 0; lon < 180; lon += 30) {
      const angle = lon * Math.PI / 180 + rotY;
      ctx.beginPath();
      ctx.ellipse(cx, cy, Math.abs(Math.cos(angle)) * R, R, 0, 0, Math.PI * 2);
      ctx.stroke();
    }

    ctx.strokeStyle = dark ? "rgba(56,189,248,0.55)" : "rgba(170,185,210,0.32)";
    ctx.lineWidth = dark ? 1.6 : 1.2;
    ctx.beginPath();
    ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.stroke();

    // dark mode: soft blue glow behind globe
    if (dark) {
      const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 0.9);
      glow.addColorStop(0, "rgba(56,189,248,0.07)");
      glow.addColorStop(1, "rgba(56,189,248,0)");
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.9, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
  }

  // ── Draw nodes ───────────────────────────────────────────────────────
  function drawNodes(projected) {
    // depth 오름차순(뒤→앞)으로 정렬해 앞 요소가 위에 그려지게
    const sorted = projected.map((p, i) => ({ ...p, i })).sort((a, b) => b.depth - a.depth);

    for (const p of sorted) {
      const item      = items[p.i];
      const isHovered = p.i === hoveredIdx;
      // depth: z=-1(front,scale↑) … z=1(back,scale↓)
      // t=1→front, t=0→back  (inverted from raw depth)
      const t = 1 - (p.depth + 1) / 2;

      // 크기: 원근(p.scale) + 추가 깊이 배율로 앞뒤 차이 강조
      const iconSize  = 15 * (0.5 + t * 0.5) * p.scale * 2.2 * (isHovered ? 1.2 : 1);
      const labelSize = Math.max(7, iconSize * 0.42);

      // 깊이별 시각 효과 (t=1 앞, t=0 뒤)
      const dark       = isDark();
      const alpha      = 0.1 + t * 0.9;
      const grayscale  = isHovered ? 0 : Math.round(Math.pow(1 - t, 0.7) * 100);
      const brightness = isHovered
        ? (dark ? 150 : 100)
        : dark
          ? Math.round(50 + t * 100)   // dark: brighter icons
          : Math.round(18 + t * 82);

      // 라벨은 앞쪽(t>0.6) 에서만 페이드인
      const labelAlpha = isHovered
        ? 1
        : t > 0.6 ? Math.min(1, (t - 0.6) / 0.28) : 0;

      ctx.save();

      // hover glow
      if (isHovered) {
        ctx.globalAlpha = 0.45;
        const gR = iconSize * 1.15;
        const grad = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, gR);
        grad.addColorStop(0, "rgba(180,200,255,0.65)");
        grad.addColorStop(1, "rgba(180,200,255,0)");
        ctx.beginPath();
        ctx.arc(p.sx, p.sy, gR, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
      }

      // 아이콘
      ctx.globalAlpha = alpha;
      ctx.filter = `grayscale(${grayscale}%) brightness(${brightness}%)`;

      const img = imgCache[item.label];
      if (img && img.complete && img.naturalWidth > 0) {
        const half = iconSize / 2;
        ctx.drawImage(img, p.sx - half, p.sy - half, iconSize, iconSize);
      } else {
        ctx.filter = `grayscale(${grayscale}%)`;
        ctx.font = `${Math.round(iconSize * 0.88)}px serif`;
        ctx.textAlign    = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(emojiFallback[item.label] ?? "•", p.sx, p.sy);
      }

      // 텍스트 라벨 (앞쪽에서만 등장)
      if (labelAlpha > 0) {
        ctx.filter      = "none";
        ctx.globalAlpha = labelAlpha;
        ctx.font        = `400 ${Math.round(labelSize * 0.78)}px 'IBM Plex Mono', monospace`;
        ctx.textAlign    = "center";
        ctx.textBaseline = "top";
        ctx.fillStyle    = isHovered ? accentColor : (isDark() ? "#7dd3fc" : "#374151");
        ctx.fillText(item.label.toUpperCase(), p.sx, p.sy + iconSize * 0.58);
      }

      ctx.restore();
    }
  }

  // ── Render loop ──────────────────────────────────────────────────────
  function getProjected() {
    return pts.map((pt) => {
      const { x, y, z } = rotate(pt.ox, pt.oy, pt.oz, rotX, rotY);
      return project(x, y, z);
    });
  }

  function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawWireframe(); // dot grid comes from CSS background behind canvas
    drawNodes(getProjected());

    if (!dragging) {
      velY += (0.0025 - velY) * 0.018;
      velX *= 0.94;
      rotY += velY;
      rotX += velX;
    }
    requestAnimationFrame(render);
  }
  render();

  // ── Hit-test ─────────────────────────────────────────────────────────
  function hitTest(mx, my) {
    const proj = getProjected();
    for (let i = proj.length - 1; i >= 0; i--) {
      const p = proj[i];
      const isSection = items[i].type === "section";
      const t    = (p.depth + 1) / 2;
      const size = 15 * (0.5 + t * 0.5) * p.scale * 2.2;
      const dx = mx - p.sx, dy = my - p.sy;
      if (Math.hypot(dx, dy) < size * 0.85) return i;
    }
    return -1;
  }

  // ── Mouse ────────────────────────────────────────────────────────────
  canvas.addEventListener("mousedown", (e) => {
    dragging = true; velX = 0; velY = 0;
    lastMX = e.clientX; lastMY = e.clientY;
    canvas.style.cursor = "grabbing";
  });
  window.addEventListener("mouseup", () => {
    dragging = false;
    canvas.style.cursor = hoveredIdx >= 0 ? "pointer" : "grab";
  });
  window.addEventListener("mousemove", (e) => {
    if (dragging) {
      velY = (e.clientX - lastMX) * 0.005;
      velX = (e.clientY - lastMY) * 0.005;
      rotY += velY; rotX += velX;
      lastMX = e.clientX; lastMY = e.clientY;
    } else {
      const rect = canvas.getBoundingClientRect();
      hoveredIdx = hitTest(e.clientX - rect.left, e.clientY - rect.top);
      canvas.style.cursor = hoveredIdx >= 0 ? "pointer" : "grab";
    }
  });
  canvas.addEventListener("click", (e) => {
    const rect = canvas.getBoundingClientRect();
    const idx  = hitTest(e.clientX - rect.left, e.clientY - rect.top);
    if (idx >= 0) {
      const el = document.querySelector(items[idx].href);
      if (el) el.scrollIntoView({ behavior: "smooth" });
    }
  });

  // ── Touch ────────────────────────────────────────────────────────────
  canvas.addEventListener("touchstart", (e) => {
    dragging = true; velX = 0; velY = 0;
    lastMX = e.touches[0].clientX; lastMY = e.touches[0].clientY;
  }, { passive: true });
  canvas.addEventListener("touchmove", (e) => {
    if (!dragging) return;
    velY = (e.touches[0].clientX - lastMX) * 0.005;
    velX = (e.touches[0].clientY - lastMY) * 0.005;
    rotY += velY; rotX += velX;
    lastMX = e.touches[0].clientX; lastMY = e.touches[0].clientY;
  }, { passive: true });
  canvas.addEventListener("touchend", () => { dragging = false; });
</script>
