---
// Resume-style accordion rows: period | company | role, click to expand.
import { siteConfig } from "../config";
import { getExperience } from "../lib/experience";
const items = getExperience();
const accent = siteConfig.accentColor;
---

{items.length > 0 && (
  <section id="experience" class="dot-bg py-10 px-10 md:px-20 lg:px-32">
    <div class="max-w-6xl mx-auto">

      {siteConfig.sectionSubtitles?.experience && (
        <span class="inline-block text-xs font-sans font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-4">
          {siteConfig.sectionSubtitles.experience}
        </span>
      )}
      <h2 class="text-gray-900 leading-tight mb-8" style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 550;">
        My Experience
      </h2>

      <div class="border-t border-gray-200">
        {items.map((exp, i) => (
          <details class="exp-row group border-b border-gray-200" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center gap-4 py-5 md:grid md:grid-cols-[150px_1fr_1fr_24px] md:gap-8">
              <span class="font-sans hidden md:block text-sm text-gray-400 tabular-nums">
                {exp.startLabel} — {exp.endLabel}
              </span>
              <span class="flex-1 min-w-0">
                <span class="flex items-center gap-2">
                  <h3 class="text-lg font-bold text-gray-900 truncate">
                    <span data-lang-en>{exp.company}</span>
                    <span data-lang-ko>{exp.companyKo ?? exp.company}</span>
                  </h3>
                  {exp.isCurrent && (
                    <span class="font-sans shrink-0 rounded-full px-2 py-0.5 text-[11px] font-bold text-white" style={`background:${accent}`}>Now</span>
                  )}
                </span>
                <span class="font-sans md:hidden block text-xs text-gray-400 tabular-nums mt-0.5">{exp.period}</span>
              </span>
              <span class="font-sans hidden md:block text-sm font-semibold truncate" style={`color:${accent}`}>
                <span data-lang-en>{exp.title}</span>
                <span data-lang-ko>{exp.titleKo ?? exp.title}</span>
              </span>
              <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" />
              </svg>
            </summary>

            <div class="font-sans pb-6 md:grid md:grid-cols-[150px_1fr] md:gap-8">
              <span class="hidden md:block"></span>
              <div>
                <p class="md:hidden text-sm font-semibold mb-2" style={`color:${accent}`}>
                  <span data-lang-en>{exp.title}</span>
                  <span data-lang-ko>{exp.titleKo ?? exp.title}</span>
                </p>
                {[
                  { lang: "en", list: exp.bullets },
                  { lang: "ko", list: exp.bulletsKo ?? exp.bullets },
                ].map(({ lang, list }) => list?.length > 0 && (
                  <ul class="space-y-1.5 break-keep" data-lang-en={lang === "en" ? "" : undefined} data-lang-ko={lang === "ko" ? "" : undefined}>
                    {list.map((b) => (
                      <li class="flex gap-2 text-sm leading-relaxed text-gray-600">
                        <span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-gray-400"></span>
                        <span set:html={b} />
                      </li>
                    ))}
                  </ul>
                ))}
                {exp.link && (
                  <a href={exp.link} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-xs font-semibold text-gray-500 underline underline-offset-4 hover:text-gray-800">
                    {exp.link.replace(/^https?:\/\//, "").replace(/\/$/, "")} ↗
                  </a>
                )}
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>
)}

<style>
  .exp-row summary::-webkit-details-marker { display: none; }
</style>
