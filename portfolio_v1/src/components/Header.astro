---
import { siteConfig } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="fixed top-5 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center">
  <nav
    id="main-nav"
    class="flex items-center gap-0.5 bg-white/85 backdrop-blur-md border border-gray-200 rounded-2xl px-2 py-2 shadow-md"
  >
    <!-- Home -->
    <a
      href={`${base}/`}
      data-label="Home"
      class="nav-icon flex items-center justify-center rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100/80"
      aria-label="Home"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/>
      </svg>
    </a>

    <!-- Blog (coming soon) -->
    <button
      id="blog-btn"
      data-label="Blog"
      class="nav-icon flex items-center justify-center rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100/80"
      aria-label="Blog"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18"/><path d="M13 8l2 0"/><path d="M13 12l2 0"/>
      </svg>
    </button>

    <!-- Resume -->
    {siteConfig.social.cv ? (
      <a
        href={siteConfig.social.cv.startsWith("/") ? `${base}${siteConfig.social.cv}` : siteConfig.social.cv}
        data-label="Resume"
        class="nav-icon flex items-center justify-center rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100/80"
        aria-label="Resume"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 12h4"/><path d="M9 16h6"/>
        </svg>
      </a>
    ) : (
      <span
        data-label="Resume"
        class="nav-icon flex items-center justify-center rounded-xl text-gray-200 cursor-not-allowed"
        aria-label="Resume (coming soon)"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 12h4"/><path d="M9 16h6"/>
        </svg>
      </span>
    )}

    <!-- Divider -->
    <div class="nav-divider w-px h-5 bg-gray-200 mx-1 shrink-0"></div>

    <!-- Language toggle -->
    <button
      id="lang-toggle"
      data-label="한국어로 보기"
      class="nav-icon flex items-center justify-center rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100/80 text-[11px] font-sans font-bold tracking-[0.06em]"
      aria-label="Toggle language"
    >
      <span id="lang-current">EN</span>
    </button>

    <!-- Night mode toggle -->
    <button
      id="night-toggle"
      class="w-9 h-9 flex items-center justify-center rounded-xl transition-all duration-200 text-gray-400 hover:text-gray-700 hover:bg-gray-100/80"
      aria-label="Toggle dark mode"
    >
      <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"/>
      </svg>
      <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
        <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/>
      </svg>
    </button>
  </nav>

  <!-- Active page label pill -->
  <div
    id="nav-label"
    class="mt-1.5 px-3 py-0.5 bg-white border border-gray-200 rounded-full text-xs font-mono text-gray-500 shadow-sm"
  >
    Home
  </div>
</header>

<style>
  .nav-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }
  .nav-icon:hover {
    transform: scale(1.22);
    background-color: #f3f4f6;
    color: #1f2937;
  }
</style>

<script>
  const navIcons = Array.from(document.querySelectorAll<HTMLElement>(".nav-icon"));
  const navLabel = document.getElementById("nav-label")!;
  let pageLabel = "Home";

  /* ── Label on hover ──────────────────────────────────── */
  navIcons.forEach((icon) => {
    icon.addEventListener("mouseenter", () => {
      if (icon.dataset.label) navLabel.textContent = icon.dataset.label;
    });
    icon.addEventListener("mouseleave", () => {
      navLabel.textContent = pageLabel;
    });
  });

  /* ── Blog coming soon ───────────────────────────────── */
  let comingSoonTimer: ReturnType<typeof setTimeout> | null = null;
  document.getElementById("blog-btn")?.addEventListener("click", () => {
    if (comingSoonTimer) clearTimeout(comingSoonTimer);
    navLabel.textContent = "Coming soon! 🚧";
    comingSoonTimer = setTimeout(() => {
      navLabel.textContent = pageLabel;
    }, 2000);
  });

  /* ── Active page highlight ───────────────────────────── */
  const path = window.location.pathname;

  function setActive(label: string) {
    pageLabel = label;
    navLabel.textContent = label;
  }

  if (path.includes("/blog")) setActive("Blog");
  else if (path.includes("/resume") || path.includes("/cv")) setActive("Resume");
  else setActive("Home");

  /* ── Night mode ──────────────────────────────────────── */
  const nightBtn = document.getElementById("night-toggle")!;
  const iconMoon = document.getElementById("icon-moon")!;
  const iconSun  = document.getElementById("icon-sun")!;
  let dark = false;

  function applyDark(on: boolean) {
    dark = on;
    document.documentElement.classList.toggle("dark", on);
    iconMoon.style.display = on ? "none" : "";
    iconSun.style.display  = on ? ""     : "none";
  }

  nightBtn.addEventListener("click", () => applyDark(!dark));

  /* ── Language (drives [data-lang-en] / [data-lang-ko] blocks) ── */
  const LANG_KEY = "site-lang";
  const langBtn     = document.getElementById("lang-toggle");
  const langCurrent = document.getElementById("lang-current");

  function applyLang(lang: string) {
    document.documentElement.dataset.lang = lang;
    if (langCurrent) langCurrent.textContent = lang.toUpperCase();
    if (langBtn) {
      langBtn.dataset.label = lang === "ko" ? "View in English" : "한국어로 보기";
      if (navLabel.textContent !== pageLabel) navLabel.textContent = langBtn.dataset.label;
    }
    try { localStorage.setItem(LANG_KEY, lang); } catch {}
    window.dispatchEvent(new CustomEvent("langchange", { detail: lang }));
  }

  let storedLang = "en";
  try { storedLang = localStorage.getItem(LANG_KEY) ?? "en"; } catch {}
  applyLang(storedLang === "ko" ? "ko" : "en");

  langBtn?.addEventListener("click", () => {
    applyLang(document.documentElement.dataset.lang === "ko" ? "en" : "ko");
  });
</script>
