---
import { siteConfig } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const navLinks = [
  { label: "About",     href: `${base}/#about` },
  { label: "Skills",    href: `${base}/#skills` },
  { label: "Projects",  href: `${base}/#projects` },
  { label: "Education", href: `${base}/#education` },
  { label: "Awards",    href: `${base}/#awards` },
];
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-4xl">
  <nav
    id="main-nav"
    class="flex items-center justify-between bg-white/55 backdrop-blur-xl border border-white/40 rounded-2xl pl-5 pr-2 py-2 shadow-md"
  >
    <!-- Logo / name -->
    <a
      href={`${base}/`}
      class="shrink-0 text-[15px] font-bold tracking-tight text-gray-900 hover:opacity-70 transition-opacity"
    >
      jo._.on
    </a>

    <!-- Center: section links -->
    <div class="hidden md:flex items-center gap-0.5">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class="px-3 py-1.5 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100/80 transition-colors"
        >
          {l.label}
        </a>
      ))}
    </div>

    <!-- Right: socials + toggles -->
    <div class="flex items-center gap-0.5 shrink-0">
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="nav-btn" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.268 2.75 1.026A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.026 2.747-1.026.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
        </a>
      )}
      {siteConfig.social.linkedin && (
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="nav-btn" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.881 3.87 6 2.5 6S.02 4.881.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8h4.52v13H.24V8zm7.5 0h4.33v1.78h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V21h-4.52v-6.75c0-1.61-.03-3.68-2.24-3.68-2.24 0-2.58 1.75-2.58 3.56V21H7.74V8z"/></svg>
        </a>
      )}
      {siteConfig.social.email && (
        <a href={`mailto:${siteConfig.social.email}`} class="nav-btn" aria-label="Email">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/></svg>
        </a>
      )}

      <div class="nav-divider w-px h-5 bg-gray-200 mx-1.5"></div>

      <!-- Language toggle -->
      <button
        id="lang-toggle"
        class="nav-btn text-[11px] font-sans font-bold tracking-[0.06em]"
        aria-label="Toggle language"
      >
        <span id="lang-current">EN</span>
      </button>

      <!-- Night mode toggle -->
      <button id="night-toggle" class="nav-btn" aria-label="Toggle dark mode">
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"/>
        </svg>
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: #9ca3af;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .nav-btn:hover {
    color: #1f2937;
    background-color: #f3f4f6;
  }
</style>

<script>
  /* ── Night mode ──────────────────────────────────────── */
  const nightBtn = document.getElementById("night-toggle")!;
  const iconMoon = document.getElementById("icon-moon")!;
  const iconSun  = document.getElementById("icon-sun")!;
  let dark = false;

  function applyDark(on: boolean) {
    dark = on;
    document.documentElement.classList.toggle("dark", on);
    iconMoon.style.display = on ? "none" : "";
    iconSun.style.display  = on ? ""     : "none";
  }

  nightBtn.addEventListener("click", () => applyDark(!dark));

  /* ── Language (drives [data-lang-en] / [data-lang-ko] blocks) ── */
  const LANG_KEY = "site-lang";
  const langBtn     = document.getElementById("lang-toggle");
  const langCurrent = document.getElementById("lang-current");

  function applyLang(lang: string) {
    document.documentElement.dataset.lang = lang;
    if (langCurrent) langCurrent.textContent = lang.toUpperCase();
    try { localStorage.setItem(LANG_KEY, lang); } catch {}
    window.dispatchEvent(new CustomEvent("langchange", { detail: lang }));
  }

  let storedLang = "en";
  try { storedLang = localStorage.getItem(LANG_KEY) ?? "en"; } catch {}
  applyLang(storedLang === "ko" ? "ko" : "en");

  langBtn?.addEventListener("click", () => {
    applyLang(document.documentElement.dataset.lang === "ko" ? "en" : "ko");
  });
</script>
