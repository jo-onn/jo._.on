---
import { siteConfig } from "../config";
const tistory = siteConfig.social.tistory;
---

<section id="blog" class="dot-bg py-10 px-10 md:px-20 lg:px-32">
  <div class="max-w-6xl mx-auto">

    <!-- Eyebrow (same style as Awards) -->
    <span class="inline-block text-xs font-sans font-bold tracking-[0.18em] text-gray-500 uppercase border border-gray-300 bg-white rounded-full px-3 py-1 mb-6">Blog</span>

    <!-- One line -->
    <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-gray-700">
      <span class="font-bold" style={`color: ${siteConfig.accentColor}`}>Coming soon!</span>
      <span class="text-gray-400" data-lang-en>New posts are on the way — earlier writing lives on Tistory.</span>
      <span class="text-gray-400" data-lang-ko>새 글을 준비하고 있어요. 이전 글은 Tistory에서 보실 수 있습니다.</span>
      {tistory && (
        <a
          href={tistory}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-gray-700 underline underline-offset-4 decoration-gray-300 hover:decoration-gray-700 transition-colors"
        >
          Tistory ↗
        </a>
      )}
    </p>

  </div>
</section>
